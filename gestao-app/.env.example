APP_NAME="Dona Arteira"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ADR-0002: o ERP roda em MariaDB. Desenvolvimento, testes e produção
# usam o mesmo banco — SQLite não reproduz SELECT ... FOR UPDATE (BR-602),
# DECIMAL sem conversão para float (ADR-0013) nem a semântica de
# transação do ledger de estoque (ADR-0008).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em desenvolvimento, `log` grava o e-mail em storage/logs em vez de
# enviar — inclusive o convite de usuário (pasta 18 §3.2).
# Produção usa SMTP da Hostinger; ver runbook 23/04 §3.7.
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@donaarteira.com.br
MAIL_PASSWORD=
# `ssl` acompanha a porta 465 (TLS implícito); a 587 usaria `tls`.
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@donaarteira.com.br"
MAIL_FROM_NAME="Dona Arteira"

# Integração com o WooCommerce (docs/15-Integracoes, docs/17-Migracao F2).
# Desligada por padrão: integração que nasce ligada dispara contra
# produção no primeiro deploy de quem só queria rodar os testes.
# Chaves em WooCommerce → Configurações → Avançado → REST API;
# permissão de LEITURA basta para a extração.
WOO_ENABLED=false
WOO_URL=https://donaarteira.com.br
WOO_KEY=
WOO_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Identity (módulo de usuários e permissões) ---------------------------
# Conta admin criada pelo AdminInicialSeeder na primeira carga do banco.
# Deixar ADMIN_INICIAL_SENHA vazio faz o seeder sortear uma senha e
# imprimi-la uma única vez no console. Em ambos os casos a troca é
# obrigatória no primeiro acesso.
ADMIN_INICIAL_NOME="Administrador"
ADMIN_INICIAL_EMAIL=admin@donaarteira.com.br
ADMIN_INICIAL_SENHA=

# Auditoria de mudanças feitas por console (artisan/tinker). Ligada por
# padrão — ver docs/26-Auditoria. Desligar apenas durante o ETL da
# migração inicial (pasta 17), que carrega centenas de milhares de linhas.
AUDIT_CONSOLE=true

# --- NF-e (docs/14, ADR-0025) ------------------------------------------
# Emissão automática de NF-e a partir do pedido confirmado do site.
# Desligada por padrão: sem certificado, sem perfis fiscais cadastrados e
# sem o pré-flight de extensões do servidor, ligar isto não emite nada
# útil — só enche a fila.
NFE_ENABLED=false

# homologacao | producao. NUNCA nasce em `producao`: docs/13-Fiscal está
# bloqueada por validação do contador (NCM/CFOP/CSOSN ainda são hipóteses),
# e emitir com dado tributário não confirmado é autuação, não bug.
# Virar a chave é decisão humana documentada em runbook (ADR-0025 §4).
NFE_ENVIRONMENT=homologacao

# Série usada pela emissão automática; o contador fica em `fiscal_series`.
NFE_SERIES=1

# UF do emitente — decide dentro/fora do estado e, com isso, o CFOP.
NFE_UF_EMITENTE=

# Certificado A1: caminho FORA do webroot e senha do cofre. Lidos pelo
# `SpedNfeGateway`, que existe mas AINDA NÃO é o bind ativo — o gateway
# ativo continua sendo o Null (ver FiscalServiceProvider).
NFE_CERT_PATH=
NFE_CERT_PASSWORD=

# Dados do emitente que vão dentro do XML (grupos emit/enderEmit).
# TODOS dependem da validação com o contador (docs/13-Fiscal/01, itens
# A-01/A-02 🔴): CNPJ, IE, regime tributário e código IBGE do município.
# Nascem vazios de propósito — a emissão recusa dizendo qual falta em vez
# de assinar uma nota com dado chutado.
NFE_EMITENTE_CNPJ=
NFE_EMITENTE_RAZAO_SOCIAL=
NFE_EMITENTE_NOME_FANTASIA=
NFE_EMITENTE_IE=

# 1=Simples Nacional (hipótese da doc 13), 2=Simples c/ excesso de
# sublimite, 3=Regime Normal, 4=MEI. Só 1/2/4 emitem com o CSOSN que
# `tax_profiles` guarda; 3 exigiria CST e alíquotas que o modelo não tem.
NFE_EMITENTE_CRT=

NFE_EMITENTE_LOGRADOURO=
NFE_EMITENTE_NUMERO=
NFE_EMITENTE_BAIRRO=
NFE_EMITENTE_MUNICIPIO=
# Código IBGE de 7 dígitos (também vira o cMunFG da nota).
NFE_EMITENTE_COD_MUNICIPIO=
NFE_EMITENTE_CEP=
# A UF sai de NFE_UF_EMITENTE, acima — não se repete aqui.

# CST de PIS/COFINS por item. Obrigatórios no layout 4.00 e decisão do
# contador (docs/13 bloqueada). O lugar definitivo é `tax_profiles`, junto
# de CFOP/CSOSN; ficam aqui enquanto a doc 13 não fecha.
NFE_PIS_CST=
NFE_COFINS_CST=

# Responsável técnico (NT 2018.005) — quem DESENVOLVE o emissor, não quem
# emite. Opcional no XSD, exigido na prática pela maioria das UFs. Fica
# fora do XML enquanto vazio; preencher antes da primeira transmissão.
NFE_RESPTEC_CNPJ=
NFE_RESPTEC_CONTATO=
NFE_RESPTEC_EMAIL=
NFE_RESPTEC_FONE=
